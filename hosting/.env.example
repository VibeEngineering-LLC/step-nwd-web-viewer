# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.
# Домен сервиса (DNS-запись типа A должна указывать на IP сервера ДО запуска)
DOMAIN=3d.example.ru
# Почта для уведомлений Let's Encrypt (не публикуется)
ACME_EMAIL=<your-email-for-letsencrypt>
# 0 — собрать образ без поддержки NWD
WITH_NWD=1
# Пределы загрузки, МБ
MAX_UPLOAD_MB_STEP=100
MAX_UPLOAD_MB_PDF=100
MAX_UPLOAD_MB_NWD=300
MAX_UPLOAD_MB_GLB=60
# Срок хранения и число продлений
RETENTION_DAYS=30
MAX_EXTENSIONS=3
# Загрузка отклоняется, если диск занят больше, %
DISK_LIMIT_PCT=85
